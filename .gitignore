# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*


# --- EspeonAnim additions ---
# Visual Studio 2022+ solution format and editor settings
*.slnx
.vsconfig
# Unreal per-user and generated folders anywhere in the tree
**/Saved/
**/Intermediate/
**/Binaries/
**/DerivedDataCache/
**/Content/Developers/
# Epic mannequin content is copied from the engine install by tools/setup_mannequin, not redistributed
EspeonAnimUE/EspeonAnim/Content/Characters/Mannequins/
# Local test footage and processing outputs
testdata/
# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
processor/models/
processor/out/
# Android / Gradle / Kotlin
.gradle/
build/
local.properties
.kotlin/
*.iml
.idea/
captures/
# Generated animation imports in the test host project
EspeonAnimUE/EspeonAnim/Content/EspeonAnim/
processor/third_party/
